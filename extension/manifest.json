{
  "manifest_version": 3,
  "name": "Minimal Starter Extension",
  "version": "1.0.0",
  "description": "A clean extension that matches your minimal starter app.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
